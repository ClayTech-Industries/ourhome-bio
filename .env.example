# OurHome Environment Variables

# ============================================================
# REQUIRED — the home won't work without these
# ============================================================

# Anthropic API key — the companion's intelligence
ANTHROPIC_API_KEY=

# Relay secret — protects API endpoints (DO NOT use 'nova' in production)
RELAY_SECRET=

# ============================================================
# OPTIONAL — Voice (STT + TTS)
# ============================================================

# ElevenLabs — high quality TTS (primary)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Groq — free STT via Whisper
GROQ_API_KEY=

# OpenAI — alternative STT/TTS (paid)
OPENAI_API_KEY=

# MiniMax — alternative TTS (paid)
MINIMAX_API_KEY=

# Mistral — alternative STT via Voxtral
MISTRAL_API_KEY=

# ============================================================
# OPTIONAL — Image Generation
# ============================================================

# Replicate — Flux schnell for image generation
REPLICATE_API_TOKEN=

# ============================================================
# OPTIONAL — Cloud Storage (R2)
# ============================================================

# Cloudflare R2 — persistent memory storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ourhome-memories

# ============================================================
# OPTIONAL — Database (Supabase)
# ============================================================

# Supabase — auth + cloud sync
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OPTIONAL — Phone Bridge (Twilio)
# ============================================================

# Twilio — SMS and voice calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# OPTIONAL — Companion Model
# ============================================================

# Model override (defaults to claude-sonnet)
COMPANION_MODEL=claude-sonnet-4-20250514

# ============================================================
# DEVELOPMENT ONLY — do not set in production
# ============================================================

# Skip auth in dev mode (middleware passes through)
# NODE_ENV=development