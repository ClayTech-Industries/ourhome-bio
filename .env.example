# OurHome Environment Variables

# ============================================================
# AI PROVIDER KEYS — Unified gateway (src/lib/ai.ts)
# Fill in whichever providers you want to use. Missing keys
# simply disable that provider. For BYOK beta users, route them
# to their own key first; fall back to these house keys later.
# ============================================================

# Anthropic — Claude
ANTHROPIC_API_KEY=

# OpenAI — GPT models
OPENAI_API_KEY=

# Google — Gemini
GOOGLE_GENERATIVE_AI_API_KEY=

# xAI — Grok (uses OpenAI-compatible REST endpoint)
XAI_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq — fast inference for open models
GROQ_API_KEY=

# Cohere
COHERE_API_KEY=

# ============================================================
# OPTIONAL — Voice (STT + TTS)
# ============================================================

# ElevenLabs — high quality TTS (primary)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# MiniMax — alternative TTS (paid)
MINIMAX_API_KEY=

# ============================================================
# OPTIONAL — Image Generation
# ============================================================

# Replicate — Flux schnell for image generation
REPLICATE_API_TOKEN=

# ============================================================
# OPTIONAL — Cloud Storage (R2)
# ============================================================

# Cloudflare R2 — persistent memory storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ourhome-memories

# ============================================================
# OPTIONAL — Database (Supabase)
# ============================================================

# Supabase — auth + cloud sync
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# OPTIONAL — Phone Bridge (Twilio)
# ============================================================

# Twilio — SMS and voice calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================
# OPTIONAL — Companion Model Defaults
# ============================================================

# Default model for the companion engine
COMPANION_MODEL=claude-sonnet-4-20250514

# ============================================================
# REQUIRED — the home won't work without these
# ============================================================

# Relay secret — protects API endpoints (DO NOT use 'nova' in production)
RELAY_SECRET=

# ============================================================
# DEVELOPMENT ONLY — do not set in production
# ============================================================

# Skip auth in dev mode (middleware passes through)
# NODE_ENV=development